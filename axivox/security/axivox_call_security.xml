<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 20 a fusionne les droits et les regles d'enregistrement dans
     `ir.access` : les deux regles que ce fichier portait sont devenues des
     lignes de security/ir.access.csv, avec leur domaine. Il ne reste que le
     groupe, qu'Odoo 20 n'a pas change.
     Ce fichier est fabrique par tools/adapt.py, il ne s'edite pas a la main. -->
<odoo>
    <record id="group_axivox_all_calls" model="res.groups">
        <field name="name">Axivox: all calls</field>
        <field name="comment">Sees and writes every call, not only their own. The
            account the Axivox connector authenticates with needs this: it files a
            call under the agent who made it, so without this it could not read
            back what it just wrote.</field>
    </record>
</odoo>
