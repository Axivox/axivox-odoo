<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="axivox_call_view_list" model="ir.ui.view">
        <field name="name">axivox.call.list</field>
        <field name="model">axivox.call</field>
        <field name="arch" type="xml">
            <list string="Calls" create="false" edit="false"
                  decoration-muted="state in ('aborted','rejected')"
                  decoration-danger="state == 'missed'">
                <field name="start_date"/>
                <field name="direction"/>
                <field name="phone_number"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="duration_s" sum="Total"/>
                <field name="state"/>
                <field name="sentiment" optional="show" widget="badge"
                       decoration-success="sentiment == 'positive'"
                       decoration-danger="sentiment == 'negative'"/>
                <field name="summary" optional="show"/>
                <field name="did" optional="hide"/>
                <field name="talk_duration_s" sum="Total" optional="hide"/>
                <field name="themes" optional="hide"/>
                <field name="escalation" optional="hide"/>
                <field name="transcription_status" optional="hide"/>
                <field name="end_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="axivox_call_view_form" model="ir.ui.view">
        <field name="name">axivox.call.form</field>
        <field name="model">axivox.call</field>
        <field name="arch" type="xml">
            <form string="Call" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="phone_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="direction" readonly="1"/>
                            <field name="did" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                            <field name="duration_s" readonly="1"/>
                            <field name="talk_duration_s" readonly="1"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="transcription_status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Analysis" invisible="not sentiment and not themes and not escalation">
                        <field name="sentiment" readonly="1"/>
                        <field name="escalation" readonly="1"/>
                        <field name="themes" readonly="1"/>
                    </group>
                    <!-- Hors du groupe a deux colonnes, et sans etiquette : un resume
                         et une transcription ont besoin de toute la largeur de la
                         feuille. Dans un <group> ils tombent dans la colonne des
                         valeurs et le texte se casse sur vingt caracteres. -->
                    <div invisible="not summary">
                        <separator string="Summary"/>
                        <field name="summary" nolabel="1" readonly="1"/>
                    </div>
                    <div invisible="not transcript">
                        <separator string="Transcript"/>
                        <field name="transcript" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="axivox_call_view_search" model="ir.ui.view">
        <field name="name">axivox.call.search</field>
        <field name="model">axivox.call</field>
        <field name="arch" type="xml">
            <search string="Calls">
                <field name="phone_number"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="summary"/>
                <field name="transcript"/>
                <field name="themes"/>
                <field name="did" string="Axivox Number"/>
                <filter name="incoming" string="Incoming" domain="[('direction','=','incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction','=','outgoing')]"/>
                <separator/>
                <filter name="missed" string="Missed" domain="[('state','=','missed')]"/>
                <filter name="mine" string="My calls" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="escalation" string="Escalation suggested" domain="[('escalation','=',True)]"/>
                <filter name="negative" string="Negative" domain="[('sentiment','=','negative')]"/>
                <filter name="positive" string="Positive" domain="[('sentiment','=','positive')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('start_date','&gt;=',context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <!-- forme canonique d'Odoo, relevee sur sa propre vue de recherche
                     des appels en 19 : un groupe nomme group_by, sans attribut
                     expand ni string, que la 19 refuse. -->
                <group name="group_by">
                    <filter name="by_partner" string="Contact" context="{'group_by':'partner_id'}"/>
                    <filter name="by_user" string="Responsible" context="{'group_by':'user_id'}"/>
                    <filter name="by_direction" string="Direction" context="{'group_by':'direction'}"/>
                    <filter name="by_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="by_sentiment" string="Sentiment" context="{'group_by':'sentiment'}"/>
                    <filter name="by_did" string="Axivox Number" context="{'group_by':'did'}"/>
                    <separator/>
                    <filter name="by_day" string="Date" context="{'group_by':'start_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="axivox_call_view_graph" model="ir.ui.view">
        <field name="name">axivox.call.graph</field>
        <field name="model">axivox.call</field>
        <field name="arch" type="xml">
            <graph string="Calls" sample="1">
                <field name="start_date" interval="day"/>
                <field name="direction"/>
                <field name="duration_s" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="axivox_call_view_pivot" model="ir.ui.view">
        <field name="name">axivox.call.pivot</field>
        <field name="model">axivox.call</field>
        <field name="arch" type="xml">
            <pivot string="Calls" sample="1">
                <field name="user_id" type="row"/>
                <field name="start_date" interval="month" type="col"/>
                <field name="duration_s" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="axivox_call_view_calendar" model="ir.ui.view">
        <field name="name">axivox.call.calendar</field>
        <field name="model">axivox.call</field>
        <field name="arch" type="xml">
            <calendar string="Calls" date_start="start_date" date_stop="end_date"
                      color="user_id" mode="week" quick_create="0">
                <field name="phone_number"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <record id="axivox_call_action" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">axivox.call</field>
        <field name="view_mode">list,form,calendar,graph,pivot</field>
        <field name="search_view_id" ref="axivox_call_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No call yet</p>
            <p>Calls handled through Axivox appear here, with their transcription
               and summary when those are enabled on your account.</p>
        </field>
    </record>

    <menuitem id="menu_axivox_root" name="Axivox" web_icon="axivox,static/description/icon.png" sequence="95"/>
    <menuitem id="menu_axivox_calls" name="Calls" parent="menu_axivox_root"
              action="axivox_call_action" sequence="10"/>

</odoo>
