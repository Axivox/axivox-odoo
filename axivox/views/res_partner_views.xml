<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="axivox_res_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.axivox.calls</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" icon="fa-phone"
                        name="action_axivox_calls" attrs="{'invisible': [('axivox_call_count','=',0)]}">
                    <field string="Calls" name="axivox_call_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
